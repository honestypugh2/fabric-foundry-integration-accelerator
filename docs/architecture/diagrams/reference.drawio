-3" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="549" y="243" width="22" height="22" as="geometry"/></mxCell><mxCell id="p5-b-4" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1069" y="243" width="22" height="22" as="geometry"/></mxCell><mxCell id="p5-b-5" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1069" y="383" width="22" height="22" as="geometry"/></mxCell><mxCell id="p5-b-6" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1329" y="383" width="22" height="22" as="geometry"/></mxCell><mxCell id="p5-b-7" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="573" y="243" width="22" height="22" as="geometry"/></mxCell><mxCell id="p5-b-8" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="549" y="943" width="22" height="22" as="geometry"/></mxCell><mxCell id="p5-band-identity-band" value="Identity: users act with their own Entra identity, and Fabric permissions decide what each one sees (on-behalf-of). The writer is a separate, least-privilege identity." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#E8F1FB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="26.0" y="1100" width="1768" height="34" as="geometry"/></mxCell><mxCell id="p5-band-policy-band" value="Authority: models propose, deterministic policy validates, a human approves, and only the scoped writer writes. MCP access and gateway policy never replace backend authorization." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#FFF8E1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="26.0" y="1142" width="1768" height="34" as="geometry"/></mxCell><mxCell id="p5-band-evidence-band" value="Evidence: every hop carries a correlation ID and an execution label. A configured server, a tool description or an existing item is not proof that an operation ran." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#E9F5EA;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="26.0" y="1184" width="1768" height="34" as="geometry"/></mxCell><mxCell id="p5-legend" value="&lt;b&gt;Legend&lt;/b&gt; · solid = implemented here or Microsoft-documented · dashed = planned, preview or optional · numbered circles = workflow steps · generated from education/architecture/views/reference.yaml (edit the YAML, then run ffia diagrams render)" style="text;html=1;fontSize=10;fontColor=#505050;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40.0" y="1246" width="1740.0" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram>
