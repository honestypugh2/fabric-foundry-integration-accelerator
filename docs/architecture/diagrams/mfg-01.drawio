e=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="809" y="383" width="22" height="22" as="geometry"/></mxCell><mxCell id="p5-b-3" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="549" y="383" width="22" height="22" as="geometry"/></mxCell><mxCell id="p5-b-4" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="289" y="383" width="22" height="22" as="geometry"/></mxCell><mxCell id="p5-b-5" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="809" y="523" width="22" height="22" as="geometry"/></mxCell><mxCell id="p5-b-6" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1069" y="523" width="22" height="22" as="geometry"/></mxCell><mxCell id="p5-b-7" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1589" y="383" width="22" height="22" as="geometry"/></mxCell><mxCell id="p5-band-identity-band" value="Identity: the Fabric data agent tool passes the signed-in user's identity (on-behalf-of); service principals are not supported for this tool. Fabric permissions and row-level security decide what the agent sees." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#E8F1FB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="26.0" y="820" width="1768" height="34" as="geometry"/></mxCell><mxCell id="p5-band-network-band" value="Boundary: web grounding queries leave the Azure compliance and geo boundary and follow Bing's terms. Restrict domains, keep confidential data out of queries, and show citations." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#F3F3F3;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="26.0" y="862" width="1768" height="34" as="geometry"/></mxCell><mxCell id="p5-band-policy-band" value="Authority: the data agent is read-only. Agents propose data fixes; a data steward approves; a Fabric pipeline corrects Silver upstream, never the report." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#FFF8E1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="26.0" y="904" width="1768" height="34" as="geometry"/></mxCell><mxCell id="p5-band-evidence-band" value="Evidence: every run is traced and evaluated; brief numbers reconcile with the governed baseline (synthetic demonstration data)." style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=11;fillColor=#E9F5EA;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="26.0" y="946" width="1768" height="34" as="geometry"/></mxCell><mxCell id="p5-legend" value="&lt;b&gt;Legend&lt;/b&gt; · solid = implemented here or Microsoft-documented · dashed = planned, preview or optional · numbered circles = workflow steps · generated from education/architecture/views/mfg-01.yaml (edit the YAML, then run ffia diagrams render)" style="text;html=1;fontSize=10;fontColor=#505050;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40.0" y="1008" width="1740.0" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram>
