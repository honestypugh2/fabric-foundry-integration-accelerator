{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__ffia-local",
      "mcp__microsoft-learn"
    ],
    "ask": [
      "Bash(az rest:*)",
      "Bash(az fabric:*)",
      "Bash(fab:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.local.yaml)",
      "Read(./**/*.local.json)",
      "mcp__fabric-mcp__onelake_delete-file",
      "mcp__fabric-mcp__onelake_delete-directory",
      "mcp__fabric-mcp__onelake_delete-shortcut",
      "mcp__fabric-mcp__onelake_delete-data-access-role",
      "mcp__fabric-mcp__onelake_modify-immutability-policy"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && uv run --frozen ffia harness guard"
          }
        ]
      }
    ]
  }
}
