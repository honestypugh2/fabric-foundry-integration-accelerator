    "steps": [
      {
        "cue": "Start with the data. Mirrored and landed data is refined from Bronze to Gold, and the semantic model holds the business definitions everyone reuses.",
        "id": "fabric",
        "label": "Fabric governed context"
      },
      {
        "cue": "Foundry adds an agent that reasons over that context. It asks a Fabric data agent on behalf of the user, so Fabric permissions still decide what is visible.",
        "id": "foundry",
        "label": "+ Foundry reasoning"
      },
      {
        "cue": "MCP standardizes how agents and coding tools reach capabilities. A gateway is optional. Note what MCP does not do - it does not grant authority.",
        "id": "mcp",
        "label": "+ MCP access"
      },
      {
        "cue": "Any change is proposed, validated by policy, approved by a person and executed only by a narrowly scoped writer. The model never approves.",
        "id": "authority",
        "label": "+ Authority"
      },
      {
        "cue": "Traces, evaluations and audit records turn every claim into evidence. Labels say what really ran.",
        "id": "evidence",
        "label": "+ Evidence"
      }
    ],
    "summary": "The end-to-end reference: governed business context in Microsoft Fabric, reasoning and orchestration in Microsoft Foundry, MCP as standardized capability access, Entra identity and policy as authority, a human-approved scoped writer for changes, and evidence at every hop.",
    "title": "Fabric + Foundry reference architecture",
    "traces": [
      {
        "demo_act": null,
        "id": "governed-question",
        "label": "PLANNED FLOW",
        "steps": [
          {
            "edge": null,
            "node": "business-users",
            "note": "Signed in with Entra ID.",
            "say": "A user asks a question in the agent experience."
          },
          {
            "edge": "users-to-app",
            "node": "agent-app",
            "note": "The app holds no data permissions of its own.",
            "say": "The app passes the conversation to the Foundry agent."
          },
          {
            "edge": "app-to-foundry",
