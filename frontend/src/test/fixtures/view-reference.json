            "note": "The Foundry Fabric data agent tool is in preview and uses the user's identity.",
            "say": "It asks the Fabric data agent on behalf of the user."
          },
          {
            "edge": "agent-to-model",
            "node": "semantic-model",
            "note": "",
            "say": "The data agent answers from the semantic model's governed measures."
          },
          {
            "edge": "model-to-lake",
            "node": "onelake",
            "note": "",
            "say": "Direct Lake reads Gold tables in OneLake. Fabric permissions filter what this user may see."
          },
          {
            "edge": null,
            "node": "foundry-agent",
            "note": "",
            "say": "The agent composes the answer with its sources."
          },
          {
            "edge": null,
