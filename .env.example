# Copy to `.env` (git-ignored). Optional `.env.local` overrides it; process variables win.
# Never commit real tenant, workspace, capacity or item identifiers, keys or connection strings.
# Real identifiers belong only in ignored .env files or legacy *.local.yaml bindings.

# Environment: offline | hybrid | live  (config/environments/<name>.yaml)
FFIA_ENVIRONMENT=hybrid
FFIA_OVERLAY=example-healthcare

# Live-first reads need ignored bindings. Missing bindings use labeled LOCAL fallback in HYBRID.
# Use `ffia serve api --offline` or `make run API_ARGS=--offline` for no cloud access.
FFIA_FABRIC_LIVE=1        # Fabric REST reads (check: ffia fabric readiness)
FFIA_FOUNDRY_LIVE=1       # Foundry agent calls (check: ffia foundry readiness)

# Preview features for this process only (comma-separated); the committed overlay stays off.
# FFIA_PREVIEW_FEATURES=foundry_iq_knowledge

# Live mutations are always opt-in and still require plan, policy and a second person's approval.
FFIA_ALLOW_LIVE_MUTATION=0

# Optional: export OpenTelemetry traces to Application Insights. Secret: .env.local only.
# FFIA_APPLICATIONINSIGHTS_CONNECTION_STRING=

# Azure/Fabric/Foundry bindings: fill these in .env, never in this tracked template.
# Named variables override the legacy config/customers/<overlay>.local.yaml file.
# Entra Azure CLI user authentication is used; no API key or client secret is required.
# AZURE_TENANT_ID=
# AZURE_SUBSCRIPTION_ID=
# AZURE_RESOURCE_GROUP=
# FABRIC_WORKSPACE_ALIAS=demo-dev
# FABRIC_WORKSPACE_ID=
# FABRIC_WORKSPACES=  # JSON alias map including semantic_models; preserves both guides' bindings
# FABRIC_CONNECTION_NAME=
# FOUNDRY_RESOURCE_NAME=
# FOUNDRY_PROJECT_NAME=
# FOUNDRY_PROJECT_ENDPOINT=
# FOUNDRY_MODEL_DEPLOYMENT=
# FOUNDRY_AGENT_NAMES=  # JSON array of existing agent names
