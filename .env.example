# Example environment variables. Copy to `.env.local` (git-ignored) and fill in locally.
# Never commit real tenant, workspace, capacity or item identifiers.

# Operating mode: offline | hybrid | live
FFIA_MODE=offline

# Live mode only. Values belong in .env.local, never in this file.
FFIA_FABRIC_WORKSPACE_ALIAS=demo-dev
FFIA_FOUNDRY_PROJECT_ALIAS=demo-project

# Live mutations are always opt-in and still require approval.
FFIA_ALLOW_LIVE_MUTATION=0
